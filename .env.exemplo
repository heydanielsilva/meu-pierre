# Copie para ".env" (mesma pasta) para usar no computador.
# Na Vercel, cadastre estas mesmas variáveis em Settings > Environment Variables.
# NUNCA envie o .env para o GitHub (o .gitignore já impede).

# --- Pluggy (Dashboard > Applications; o Secret só aparece uma vez) ---
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Um itemId por banco conectado no Meu Pluggy, com apelido depois dos dois-pontos.
# Dashboard > Applications > sua aplicação > Demo > Connected Items
PLUGGY_ITEMS=00000000-0000-0000-0000-000000000000:Nubank,11111111-1111-1111-1111-111111111111:Itaú

# --- Nuvem (Vercel) ---
# Banco Postgres (Neon). Na Vercel é criado sozinho ao conectar o Neon ao projeto.
# No computador, deixe vazio para usar SQLite, ou cole o do Neon para fazer a carga inicial.
DATABASE_URL=

# Senha do conector (mínimo 32 caracteres). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MEU_PIERRE_TOKEN=

# Senha do cron diário (gere do mesmo jeito, valor diferente do token)
CRON_SECRET=

# --- Opcionais ---
SALDO_MINIMO=500
MEU_PIERRE_DEMO=0
